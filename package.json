{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build:platform && node server/index.mjs",
    "build": "npm run build:platform",
    "start": "node server/index.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:online": "npm run build:platform",
    "build:platform": "node scripts/build-platform.mjs",
